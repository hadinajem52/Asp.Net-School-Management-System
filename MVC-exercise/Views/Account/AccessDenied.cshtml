@{
    ViewData["Title"] = "Access denied";
}

<section class="auth-page" aria-labelledby="access-denied-heading">
    <p class="eyebrow">Restricted area</p>
    <h1 id="access-denied-heading">Access denied</h1>
    <p class="form-introduction">Your account does not have permission to open this page.</p>

    <div class="auth-form">
        <p class="access-denied-message">Return to the dashboard or contact an administrator if you believe your access should be changed.</p>
        <div class="form-actions">
            <a class="button-primary" asp-controller="Home" asp-action="Index">Return to dashboard</a>
        </div>
    </div>
</section>
