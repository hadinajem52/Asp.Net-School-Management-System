<dialog class="confirmation-dialog" id="confirmation-dialog" aria-labelledby="confirmation-title" aria-describedby="confirmation-message">
    <div class="confirmation-dialog-content">
        <p class="eyebrow">Please confirm</p>
        <h2 id="confirmation-title">Continue with this action?</h2>
        <p id="confirmation-message">This action may change stored data.</p>
        <div class="form-actions">
            <button class="button-danger" id="confirmation-accept" type="button">Confirm</button>
            <button class="button-secondary" id="confirmation-cancel" type="button">Cancel</button>
        </div>
    </div>
</dialog>
