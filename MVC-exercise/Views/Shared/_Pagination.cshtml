@model MVC_exercise.ViewModels.Shared.PaginationViewModel
@{
    var previousUrl = Url.Action(Model.Action, Model.Controller, new
    {
        page = Model.PageNumber - 1,
        searchTerm = Model.SearchTerm,
        sortBy = Model.SortBy
    });
    var nextUrl = Url.Action(Model.Action, Model.Controller, new
    {
        page = Model.PageNumber + 1,
        searchTerm = Model.SearchTerm,
        sortBy = Model.SortBy
    });
}

<nav class="pagination-controls" aria-label="@Model.AriaLabel">
    @if (Model.PageNumber > 1)
    {
        <a class="button-secondary" href="@previousUrl">Previous</a>
    }
    else
    {
        <span class="pagination-disabled">Previous</span>
    }

    <span class="pagination-summary">Page @Model.PageNumber of @Model.TotalPages</span>

    @if (Model.PageNumber < Model.TotalPages)
    {
        <a class="button-secondary" href="@nextUrl">Next</a>
    }
    else
    {
        <span class="pagination-disabled">Next</span>
    }
</nav>
