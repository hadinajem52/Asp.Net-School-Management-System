@page
@model razor_exercise.Pages.Courses.CreateModel
@{
    ViewData["Title"] = "Add course";
}

<section class="form-page" aria-labelledby="add-course-title">
    <a class="back-link" asp-page="./Index">← Back to courses</a>
    <p class="eyebrow">New course</p>
    <h1 id="add-course-title">Add a course</h1>
    <p class="form-introduction">Complete the course details below. Required fields are marked with an asterisk.</p>

    <form method="post" class="course-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <div class="form-grid">
            <div class="form-field form-field-wide">
                <label asp-for="Course.Name">Course name <span aria-hidden="true">*</span></label>
                <input asp-for="Course.Name" autocomplete="off" />
                <span asp-validation-for="Course.Name" class="field-error"></span>
            </div>

            <div class="form-field form-field-wide">
                <label asp-for="Course.Description">Description <span aria-hidden="true">*</span></label>
                <textarea asp-for="Course.Description" rows="5"></textarea>
                <span asp-validation-for="Course.Description" class="field-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Course.Credits">Credits <span aria-hidden="true">*</span></label>
                <input asp-for="Course.Credits" type="number" min="1" max="6" />
                <span asp-validation-for="Course.Credits" class="field-error"></span>
            </div>
        </div>

        <div class="form-actions">
            <button class="button-primary" type="submit">Save course</button>
            <a class="button-secondary" asp-page="./Index">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
