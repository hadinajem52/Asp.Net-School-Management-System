@page
@model razor_exercise.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Request access";
    ViewData["HideNavigation"] = true;
}

<section class="auth-page" aria-labelledby="register-heading">
    <p class="eyebrow">New account</p>
    <h1 id="register-heading">Request access</h1>
    <p class="form-introduction">Create an account for read-only access. An administrator must approve your request before you can sign in.</p>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <div class="form-field">
            <label asp-for="Input.Email">Email <span aria-hidden="true">*</span></label>
            <input asp-for="Input.Email" autocomplete="email" autofocus />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Password">Password <span aria-hidden="true">*</span></label>
            <input asp-for="Input.Password" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.ConfirmPassword">Confirm password <span aria-hidden="true">*</span></label>
            <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="button-primary">Send access request</button>
        </div>
    </form>

    <p class="account-switch">Already have an account? <a asp-page="./Login">Sign in</a></p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
